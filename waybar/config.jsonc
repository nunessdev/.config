{
    "position": "top",
    "height": 35,
    "spacing": 4,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "tray",
        "network",
        "cpu",
        "memory",
        "pulseaudio",
	"backlight",
        "battery"
    ],

    "clock": {
        "format": "{:%I:%M %p}"
    },

    "network": {
        "format-wifi": "{ifname} {signalStrength}%",
	"format-ethernet": "{ifname}",
        "format-disconnected": "Disconn",
	"tooltip-format": "SSID: {essid}\nIP: {ipaddr}",
   	"interval": 5,
	"on-click": "kitty nmtui"
    },

    "cpu": {
        "format": "cpu {}%"
    },

    "memory": {
        "format": "ram {}%"
    },

    "backlight": {
	"format": "bl {percent}%",
	"tooltip-format": "Backlight {percent}%",
	"reverse-scrolling": true
    },

    "pulseaudio": {
        "format": "vol {volume}%",
	"reverse-scrolling": true,
	"on-click": "pavucontrol"
    }
}

