{
    "position": "top",
    "height": 35,
    "spacing": 4,

    // matches hyprland gaps_out = 10 (top right bottom left)
    // bottom is 0 because hyprland already adds gaps_out between the bar and windows
    "margin": "10 10 0 10",

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "tray",
        "network",
        "cpu",
        "memory",
        "pulseaudio",
        "backlight",
        "power-profiles-daemon",
        "battery"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true,
        "persistent-workspaces": {
            "*": [1, 2, 3, 4]
        }
    },

    "clock": {
        "format": "{:%I:%M %p}"
    },

    "network": {
        "format-wifi": "{ifname} {signalStrength}%",
        "format-ethernet": "{ifname}",
        "format-disconnected": "Disconn",
        "tooltip-format": "SSID: {essid}\nIP: {ipaddr}",
        "interval": 5,
        "on-click": "kitty nmtui"
    },

    "cpu": {
        "format": "cpu {}%"
    },

    "memory": {
        "format": "ram {}%"
    },

    "backlight": {
        "format": "bl {percent}%",
        "tooltip-format": "Backlight {percent}%",
        "reverse-scrolling": true
    },

    "pulseaudio": {
        "format": "vol {volume}%",
        "format-muted": "vol muted",
        "reverse-scrolling": true,
        "on-click": "pavucontrol"
    },

    // click cycles through the profiles
    "power-profiles-daemon": {
        "format": "pwr {icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "format-icons": {
            "default": "?",
            "performance": "perf",
            "balanced": "bal",
            "power-saver": "save"
        }
    },

    "battery": {
        "format": "bat {capacity}%",
        "format-charging": "chg {capacity}%",
        "states": {
            "warning": 30,
            "critical": 15
        }
    }
}
